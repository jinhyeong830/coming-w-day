# Supabase 방명록 연동에 필요한 환경변수. 실제 값은 .env.local에만 설정하고
# 이 파일에는 절대 채우지 않는다 (.env.local은 Git에 커밋하지 않는다).

# 브라우저에 노출되는 값 (SELECT는 클라이언트에서 anon/publishable key로 직접 조회)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 값 (app/api/guestbook에서만 사용, RLS를 우회하는 service role key이므로
# 절대 NEXT_PUBLIC_ 접두사를 붙이거나 클라이언트 코드에서 import하지 않는다)
SUPABASE_SERVICE_ROLE_KEY=
